<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>iRacingSDK</AssemblyName>
    <ProjectGuid>{5422AE20-F220-4BE1-9E61-5296981ABB5C}</ProjectGuid>
    <RootNamespace>iRacingSDK</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeSdkProjectDirectory>$(MSBuildThisFileDirectory)..\Native\iRacingSdkNative\</NativeSdkProjectDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Reference Include="System.Runtime.Serialization" />
    <ProjectReference Include="$(NativeSdkProjectDirectory)iRacingSdkNative.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      SetPlatform="Platform=x64" />
    <None Include="$(NativeSdkProjectDirectory)bin\$(Configuration)\ReplayDirector.iRacingNative.dll"
          Link="ReplayDirector.iRacingNative.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NativeSdkProjectDirectory)LICENSE.txt"
          Link="iRacing-SDK-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
